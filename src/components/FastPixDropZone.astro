---
import "../styles/tokens.css";
import "../styles/drop-zone.css";

interface Props {
  class?: string;
  overlay?: boolean;
  label?: string;
}

const {
  class: className,
  overlay = false,
  label = "Drag a file here, or press to browse",
} = Astro.props;
---

<fastpix-drop-zone>
  <div class="fastpix-dropzone-wrapper">
    <button type="button" class:list={["fastpix-dropzone", className]} aria-label={label}>
      <slot />
    </button>
    <input type="file" hidden />
    {overlay && <div class="fastpix-dropzone-overlay" aria-hidden="true" />}
  </div>
</fastpix-drop-zone>
