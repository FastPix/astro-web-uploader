---
import "../styles/tokens.css";
import "../styles/track.css";

import RadialTrack from "./svgs/RadialTrack.astro";

interface Props {
  class?: string;
  variant?: "linear" | "radial";
  showLabel?: boolean;
}

// prettier-ignore
const {
  class: className,
  variant = "linear",
  showLabel = false,
} = Astro.props;

// must match RADIAL_RADIUS in src/client/elements/track.ts
const r = 42;
const circumference = 2 * Math.PI * r;

// prettier-ignore
const radialClasses = [
  "fastpix-track",
  "fastpix-track-radial",
  className,
];
---

<fastpix-track variant={variant}>
  {
    variant === "radial" ? (
      <div class:list={radialClasses}>
        <RadialTrack radius={r} circumference={circumference} />

        {showLabel && <span class="fastpix-track-label">0%</span>}
      </div>
    ) : (
      <div class:list={["fastpix-track", className]}>
        <div class="fastpix-track-bar">
          <div class="fastpix-track-fill" />
        </div>
        {showLabel && <span class="fastpix-track-label">0%</span>}
      </div>
    )
  }
</fastpix-track>
