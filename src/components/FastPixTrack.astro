---
import "../styles/tokens.css";
import "../styles/track.css";

interface Props {
  class?: string;
  variant?: "linear" | "radial";
  showLabel?: boolean;
}

const { class: className, variant = "linear", showLabel = false } = Astro.props;

const r = 42;
const circumference = 2 * Math.PI * r;
---

<fpx-track variant={variant}>
  {
    variant === "radial" ? (
      <div class:list={["fpx-track", "fpx-track-radial", className]}>
        <svg viewBox="0 0 100 100" class="fpx-radial-svg">
          <circle class="fpx-radial-bg" cx="50" cy="50" r={r} />
          <circle
            class="fpx-radial-fill"
            cx="50"
            cy="50"
            r={r}
            stroke-dasharray={circumference}
            stroke-dashoffset={circumference}
          />
        </svg>
        {showLabel && <span class="fpx-track-label">0%</span>}
      </div>
    ) : (
      <div class:list={["fpx-track", className]}>
        <div class="fpx-track-bar">
          <div class="fpx-track-fill" />
        </div>
        {showLabel && <span class="fpx-track-label">0%</span>}
      </div>
    )
  }
</fpx-track>
