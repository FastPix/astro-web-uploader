---
import "../styles/tokens.css";
import "../styles/host.css";

import AbortButton from "./FastPixAbortButton.astro";
import DropZone from "./FastPixDropZone.astro";
import PauseButton from "./FastPixPauseButton.astro";
import ResumeButton from "./FastPixResumeButton.astro";
import StartButton from "./FastPixStartButton.astro";
import Status from "./FastPixStatus.astro";
import Track from "./FastPixTrack.astro";

interface FastPixAppearance {
  accentColor?: string;
  background?: string;
  surface?: string;
  textColor?: string;
  mutedColor?: string;
  borderColor?: string;
  radius?: string;
  fontFamily?: string;
  trackHeight?: string;
  trackFill?: string;
  errorColor?: string;
  successColor?: string;
}

interface Props {
  endpoint?: string;
  accept?: string;
  maxFileSize?: number;
  chunkSize?: number;
  retryChunkAttempt?: number;
  delayRetry?: number;
  autoStart?: boolean;
  disabled?: boolean;
  // prettier-ignore
  size?:
    | "sm"
    | "md"
    | "lg";
  appearance?: FastPixAppearance;
  id?: string;
  class?: string;
}

const {
  endpoint,
  accept,
  maxFileSize,
  chunkSize,
  retryChunkAttempt,
  delayRetry,
  autoStart,
  disabled = false,
  size = "md",
  appearance,
  id,
  class: className,
} = Astro.props;

const APPEARANCE_VARS: Record<keyof FastPixAppearance, string> = {
  accentColor: "--fastpix-accent-color",
  background: "--fastpix-bg",
  surface: "--fastpix-surface",
  textColor: "--fastpix-text-color",
  mutedColor: "--fastpix-text-muted",
  borderColor: "--fastpix-border-color",
  radius: "--fastpix-radius",
  fontFamily: "--fastpix-font-family",
  trackHeight: "--fastpix-track-height",
  trackFill: "--fastpix-track-fill",
  errorColor: "--fastpix-error-color",
  successColor: "--fastpix-success-color",
};

const appearanceStyle = appearance
  ? (Object.entries(appearance) as [keyof FastPixAppearance, string][])
      .filter(([, v]) => v != null)
      .map(([k, v]) => `${APPEARANCE_VARS[k]}: ${v};`)
      .join(" ")
  : undefined;

const custom = Astro.slots.has("default");
---

<fastpix-uploader
  id={id}
  class:list={["fastpix-uploader", className]}
  endpoint={endpoint}
  accept={accept}
  max-file-size={maxFileSize}
  chunk-size={chunkSize}
  retry-chunk-attempt={retryChunkAttempt}
  delay-retry={delayRetry}
  auto-start={autoStart === undefined ? undefined : String(autoStart)}
  disabled={disabled || undefined}
  data-fastpix-state="idle"
  data-fastpix-size={size}
  data-fastpix-disabled={disabled || undefined}
  style={appearanceStyle}
>
  {
    custom ? (
      <slot />
    ) : (
      <div class="fastpix-default">
        <div class="fastpix-default-drop-section" data-fastpix-show="idle ready">
          <DropZone overlay class="fastpix-default-drop">
            <Status class="fastpix-default-hint" />
          </DropZone>
        </div>

        <div class="fastpix-controls" data-fastpix-show="ready">
          <StartButton />
        </div>

        <div class="fastpix-default-progress" data-fastpix-show="resolving uploading paused">
          <Status />
          <Track showLabel />
          <div class="fastpix-controls">
            <PauseButton />
            <ResumeButton />
            <AbortButton />
          </div>
        </div>

        <div class="fastpix-default-error" data-fastpix-show="error">
          <Status />
          <StartButton>Retry</StartButton>
        </div>

        <div class="fastpix-default-success" data-fastpix-show="success">
          <Status />
        </div>
      </div>
    )
  }
</fastpix-uploader>

<script>
  import { register } from "@fastpix/fp-astro-uploader/client";
  register();
</script>
