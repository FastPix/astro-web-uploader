---
import "../styles/tokens.css";
import "../styles/status.css";

// prettier-ignore
type UploaderStatus =
  | "idle"
  | "ready"
  | "resolving"
  | "uploading"
  | "paused"
  | "error"
  | "success";

interface Props {
  class?: string;
  labels?: Partial<Record<UploaderStatus, string>>;
}

const { class: className, labels } = Astro.props;

const labelAttrs = Object.fromEntries(
  Object.entries(labels ?? {}).map(([state, text]) => [`label-${state}`, text]),
);

const idleText = labels?.idle ?? "Select a file to upload";
---

<fastpix-status {...labelAttrs}>
  <span
    class:list={["fastpix-status", className]}
    data-fastpix-state="idle"
    role="status"
    aria-live="polite">{idleText}</span
  >
</fastpix-status>
