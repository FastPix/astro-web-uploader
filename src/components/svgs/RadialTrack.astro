---
interface Props {
  radius: number;
  circumference: number;
}

const { radius, circumference } = Astro.props;
---

<svg viewBox="0 0 100 100" class="fastpix-radial-svg">
  <circle class="fastpix-radial-bg" cx="50" cy="50" r={radius}></circle>

  <circle
    class="fastpix-radial-fill"
    cx="50"
    cy="50"
    r={radius}
    stroke-dasharray={circumference}
    stroke-dashoffset={circumference}></circle>
</svg>
