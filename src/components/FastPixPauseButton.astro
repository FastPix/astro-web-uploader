---
import "../styles/tokens.css";
import "../styles/buttons.css";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// prettier-ignore
const classes = [
  "fastpix-button",
  "fastpix-pause-button",
  className,
];
---

<fastpix-button action="pause">
  <button type="button" class:list={classes} disabled>
    <slot>Pause</slot>
  </button>
</fastpix-button>
