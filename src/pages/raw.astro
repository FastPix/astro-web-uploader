---
// Raw-element path: NO .astro uploader components on this page, so no
// build-time CSS — register() must inject the embedded stylesheet itself.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>raw fastpix-* elements</title>
  </head>
  <body>
    <h1>Raw &lt;fastpix-*&gt; elements</h1>

    <div id="mount"></div>

    <script>
      import { register } from "@fastpix/fp-astro-uploader/client";
      register();

      document.querySelector("#mount")!.innerHTML = `
        <fastpix-uploader
          id="up-raw"
          accept="video/*"
          auto-start="false"
          data-fastpix-state="idle"
          data-fastpix-size="md"
        >
          <fastpix-file-picker>
            <button type="button" class="fastpix-file-picker">Browse…</button>
            <input type="file" hidden />
          </fastpix-file-picker>
          <fastpix-status>
            <span
              class="fastpix-status"
              role="status"
              aria-live="polite"
              data-fastpix-state="idle"
            ></span>
          </fastpix-status>
        </fastpix-uploader>`;
    </script>
  </body>
</html>
